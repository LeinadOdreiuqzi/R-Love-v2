<svg width="16" height="16" xmlns="http://www.w3.org/2000/svg">
  <!-- EVA Suit Body -->
  <circle cx="8" cy="10" r="4" fill="#E0E0E0" stroke="#B0B0B0" stroke-width="1"/>
  
  <!-- Helmet -->
  <circle cx="8" cy="6" r="3" fill="#F0F0F0" stroke="#C0C0C0" stroke-width="1"/>
  
  <!-- Helmet Visor -->
  <circle cx="8" cy="6" r="2" fill="#4A90E2" opacity="0.7"/>
  
  <!-- Life Support Pack -->
  <rect x="6" y="12" width="4" height="2" fill="#808080" stroke="#606060" stroke-width="0.5"/>
  
  <!-- Arms -->
  <circle cx="4" cy="9" r="1.5" fill="#E0E0E0" stroke="#B0B0B0" stroke-width="0.5"/>
  <circle cx="12" cy="9" r="1.5" fill="#E0E0E0" stroke="#B0B0B0" stroke-width="0.5"/>
  
  <!-- Legs -->
  <circle cx="6" cy="14" r="1" fill="#E0E0E0" stroke="#B0B0B0" stroke-width="0.5"/>
  <circle cx="10" cy="14" r="1" fill="#E0E0E0" stroke="#B0B0B0" stroke-width="0.5"/>
  
  <!-- Status Light -->
  <circle cx="8" cy="8" r="0.5" fill="#00FF00"/>
</svg>