<svg width="16" height="16" xmlns="http://www.w3.org/2000/svg">
  <!-- Astronaut body (basic space suit) -->
  <rect x="6" y="4" width="4" height="8" fill="#E0E0E0"/>
  
  <!-- Helmet -->
  <rect x="5" y="2" width="6" height="4" fill="#F0F0F0"/>
  <rect x="6" y="3" width="4" height="2" fill="#87CEEB"/>
  
  <!-- Arms -->
  <rect x="4" y="5" width="2" height="4" fill="#E0E0E0"/>
  <rect x="10" y="5" width="2" height="4" fill="#E0E0E0"/>
  
  <!-- Legs -->
  <rect x="6" y="12" width="1" height="3" fill="#E0E0E0"/>
  <rect x="9" y="12" width="1" height="3" fill="#E0E0E0"/>
  
  <!-- Chest panel -->
  <rect x="7" y="6" width="2" height="2" fill="#4169E1"/>
  
  <!-- Helmet reflection -->
  <rect x="6" y="3" width="1" height="1" fill="#FFFFFF"/>
</svg>